# Environment Variables for Railway Deployment
# Copy these variables to your Railway service environment settings

# TinaCMS Configuration
VITE_TINA_CLIENT_ID=your_tina_client_id_here
TINA_TOKEN=your_tina_token_here

# Production Settings
NODE_ENV=production
PORT=4001

# Railway automatically sets PORT, but we include it here for reference
# The actual PORT will be set by Railway and override this value

# Instructions:
# 1. Go to your Railway project dashboard
# 2. Select your service
# 3. Go to Variables tab
# 4. Add each variable above with your actual values
# 5. For VITE_TINA_CLIENT_ID and TINA_TOKEN, get these from your TinaCMS Cloud account
# 6. If you don't have TinaCMS Cloud set up yet, visit https://app.tina.io to create an account