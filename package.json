{
  "name": "monumentaltimesworkspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-manifest && vite build",
    "start": "node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-manifest": "node scripts/generate-article-manifest.js",
    "predeploy": "npm run generate-manifest && npm run build",
    "deploy": "gh-pages -d dist",
    "publish": "git add public/content/articles/ public/images/ && git commit -m \"Added new articles\" && npm run deploy"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@sanity/client": "^6.21.0",
    "@sanity/image-url": "^1.0.2",
    "gray-matter": "^4.0.3",
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@sanity/cli": "^3.38.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0"
  }
}
